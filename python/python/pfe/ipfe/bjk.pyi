from collections.abc import Sequence
from typing import SupportsIndex, final

__all__ = [
    "MasterKey",
    "Key",
    "Ciphertext",
    "PreparedKey",
    "setup",
    "keygen",
    "encrypt",
    "prepare",
    "decrypt",
]

@final
class MasterKey:
    def __new__(cls, data: bytes) -> MasterKey: ...
    @staticmethod
    def from_bytes(data: bytes) -> MasterKey: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[MasterKey], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class Key:
    def __new__(cls, data: bytes) -> Key: ...
    @staticmethod
    def from_bytes(data: bytes) -> Key: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[Key], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class Ciphertext:
    def __new__(cls, data: bytes) -> Ciphertext: ...
    @staticmethod
    def from_bytes(data: bytes) -> Ciphertext: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[Ciphertext], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class PreparedKey:
    @property
    def n(self) -> int: ...

def setup(n: int) -> MasterKey: ...
def keygen(msk: MasterKey, function: Sequence[SupportsIndex]) -> Key: ...
def encrypt(msk: MasterKey, message: Sequence[SupportsIndex]) -> Ciphertext: ...
def prepare(sk: Key) -> PreparedKey: ...
def decrypt(sk: Key | PreparedKey, ct: Ciphertext, lo: int, hi: int) -> int | None: ...
