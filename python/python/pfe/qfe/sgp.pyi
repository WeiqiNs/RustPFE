from collections.abc import Sequence
from typing import SupportsIndex, final

from pfe import DlogTable, Gt

__all__ = [
    "MasterKey",
    "Key",
    "Ciphertext",
    "PreparedKey",
    "PublicKey",
    "setup",
    "keygen",
    "encrypt",
    "prepare",
    "decrypt",
    "base",
]

@final
class MasterKey:
    def __new__(cls, data: bytes) -> MasterKey: ...
    @staticmethod
    def from_bytes(data: bytes) -> MasterKey: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[MasterKey], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class Key:
    def __new__(cls, data: bytes) -> Key: ...
    @staticmethod
    def from_bytes(data: bytes) -> Key: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[Key], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class Ciphertext:
    def __new__(cls, data: bytes) -> Ciphertext: ...
    @staticmethod
    def from_bytes(data: bytes) -> Ciphertext: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[Ciphertext], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

@final
class PreparedKey:
    @property
    def n(self) -> int: ...

@final
class PublicKey:
    def __new__(cls, data: bytes) -> PublicKey: ...
    @staticmethod
    def from_bytes(data: bytes) -> PublicKey: ...
    def __bytes__(self) -> bytes: ...
    def __reduce__(self) -> tuple[type[PublicKey], tuple[bytes]]: ...
    @property
    def n(self) -> int: ...

def setup(n: int) -> tuple[PublicKey, MasterKey]: ...
def keygen(msk: MasterKey, function: Sequence[Sequence[SupportsIndex]]) -> Key: ...
def encrypt(pk: PublicKey, left: Sequence[SupportsIndex], right: Sequence[SupportsIndex]) -> Ciphertext: ...
def prepare(sk: Key) -> PreparedKey: ...
def decrypt(table: DlogTable, sk: Key | PreparedKey, ct: Ciphertext) -> int | None: ...
def base() -> Gt: ...
